# ============================================================
# FMS deployment — root compose environment
# Copy to `.env` (gitignored) and fill in real values:
#   cp .env.example .env && nano .env
# Then run: bash deploy/setup.sh
# ============================================================

# Postgres superuser password for the app role (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me

# Public base URL for n8n (used for webhook callbacks + editor).
# Before a named tunnel/domain exists, leave as localhost. When you have
# api/n8n hostnames on a Cloudflare tunnel, set e.g.:
#   N8N_PUBLIC_URL=https://n8n.example.com
N8N_PUBLIC_URL=http://localhost:5678/
