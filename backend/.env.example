# ============================================================
# FMS backend — environment
# Copy to backend/.env (gitignored) and fill in real values:
#   cp backend/.env.example backend/.env && nano backend/.env
# ============================================================

# Pointed at the compose `db` service. ${POSTGRES_PASSWORD} must match
# POSTGRES_PASSWORD in the root .env
DATABASE_URL=postgresql://@db:5432/
PORT=5000

# CORS origin(s) — the deployed frontend, comma-separated for several, e.g.
# https://app.ittefaqbuilder.com,https://ittefaqbuilder.com,https://www.ittefaqbuilder.com
FRONTEND_URL=http://localhost:5173

# App JWT signing secret (generate: openssl rand -hex 32)
JWT_SECRET=change-me

# LLM keys. GROQ_API_KEY is only read by routes/nlp-search.js, which is
# currently entirely commented out (dead code, not mounted). DEEPSEEK_API_KEY
# isn't referenced anywhere in the codebase yet. Kept here since both are
# already set in the real .env — get from console.groq.com / platform.deepseek.com
# if/when that route is revived.
GROQ_API_KEY=change-me
DEEPSEEK_API_KEY=change-me

# Meta (Facebook) WhatsApp Business Cloud API. The backend never calls Meta
# directly — only the n8n workflow does, using the matching values in
# deploy/.env.n8n — these are kept here too just for a single place to look
# up all WhatsApp config. Get both from developers.facebook.com -> your app
# -> WhatsApp -> API Setup.
META_WHATSAPP_TOKEN=change-me
META_PHONE_NUMBER_ID=change-me
OWNER_WHATSAPP=whatsapp:+

# n8n alert webhook (backend -> n8n). Uses the internal Docker hostname.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/fms-alert
# Sent as the X-FMS-Secret header on every alert; must equal N8N_WEBHOOK_SECRET
# in deploy/.env.n8n (the n8n Webhook node rejects requests without it).
# Generate with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=change-me

# Factory desktop app -> this server sync (routes/sync.js). Any value switches
# /sync on; leave unset to disable it entirely (the factory PC's own backend
# leaves it unset). It is not a credential: the factory app registers with a
# one-time setup code from Offline Setup and then uses its own upload key.
# Generate with: openssl rand -hex 32
SYNC_TOKEN=

# true once the factory desktop app has taken over as the only place data is
# entered: blocks every save on this server (logins still work), stops cron
# jobs, and is required before the factory app can copy data via
# GET /sync/snapshot.
READ_ONLY_MODE=false

# send_only once the factory app is live (T2.1): scheduled reports and the
# daily digests are sent from here (services/sendOnlyScheduler.js), read from
# the mirror, so they arrive even when the factory PC is off. Replaces the
# normal cron jobs on this server and writes only report_dispatch_log. The
# factory app runs none then (DISABLE_CRON, set by desktop/main.js).
# Leave unset before go-live.
REPORT_SENDER_MODE=

# Public address of the same n8n webhook (through the tunnel), handed to the
# factory desktop app via GET /sync/config so it can send WhatsApp alerts
# itself. Unset = the factory app queues alerts and never sends them.
N8N_PUBLIC_WEBHOOK_URL=https://n8n.ittefaqbuilder.com/webhook/fms-alert
