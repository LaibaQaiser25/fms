# ============================================================
# FMS backend — environment
# Copy to backend/.env (gitignored) and fill in real values:
#   cp backend/.env.example backend/.env && nano backend/.env
# ============================================================

# Pointed at the compose `db` service. ${POSTGRES_PASSWORD} must match
# POSTGRES_PASSWORD in the root .env
DATABASE_URL=postgresql://postgres:postgres-25@db:5432/fms_db
PORT=5000

# CORS origin — the deployed frontend (Vercel / your domain)
FRONTEND_URL=http://localhost:5173

# App JWT signing secret (generate: openssl rand -hex 32)
JWT_SECRET=change-me

# Meta (Facebook) WhatsApp Business Cloud API. The backend never calls Meta
# directly — only the n8n workflow does, using the matching values in
# deploy/.env.n8n — these are kept here too just for a single place to look
# up all WhatsApp config. Get both from developers.facebook.com -> your app
# -> WhatsApp -> API Setup.
META_WHATSAPP_TOKEN=change-me
META_PHONE_NUMBER_ID=change-me
OWNER_WHATSAPP=whatsapp:+923007140671

# n8n alert webhook (backend -> n8n). Uses the internal Docker hostname.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/fms-alert
