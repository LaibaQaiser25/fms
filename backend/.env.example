# ============================================================
# FMS backend — environment
# Copy to backend/.env (gitignored) and fill in real values:
#   cp backend/.env.example backend/.env && nano backend/.env
# ============================================================

# Pointed at the compose `db` service. ${POSTGRES_PASSWORD} must match
# POSTGRES_PASSWORD in the root .env
DATABASE_URL=postgresql://fms_app:change-me@db:5432/fms_db
PORT=5000

# CORS origin — the deployed frontend (Vercel / your domain)
FRONTEND_URL=http://localhost:5173

# App JWT signing secret (generate: openssl rand -hex 32)
JWT_SECRET=change-me

# AI keys used by /api/nlp and similar
GROQ_API_KEY=change-me
DEEPSEEK_API_KEY=change-me

# Twilio (WhatsApp alerts). Auth Token must be the CURRENT one from the
# Twilio console — the value previously committed to git is revoked/stale.
TWILIO_ACCOUNT_SID=change-me
TWILIO_AUTH_TOKEN=change-me
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP=whatsapp:+923007140671

# n8n alert webhook (backend -> n8n). Uses the internal Docker hostname.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/fms-alert

# Shared secrets between backend and n8n (generate each: openssl rand -hex 24)
# BACKEND_WEBHOOK_SECRET must match deploy/.env.n8n's BACKEND_WEBHOOK_SECRET.
BACKEND_WEBHOOK_SECRET=change-me
# N8N_INBOUND_SECRET is checked by backend/routes/webhooks.js when n8n asks for
# a report; it must match what the inbound n8n workflow sends.
N8N_INBOUND_SECRET=change-me
