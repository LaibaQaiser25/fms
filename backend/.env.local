# LOCAL DEV ONLY — used by docker-compose.local.yml. Nothing here points at the VPS.
# DATABASE_URL is set in docker-compose.local.yml (local db container).
PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=local-dev-secret-not-for-production

# Alerts disabled: no webhook URL means no WhatsApp messages from local tests.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_PUBLIC_WEBHOOK_URL=

# Sync disabled; writes allowed.
SYNC_TOKEN=
READ_ONLY_MODE=false

GROQ_API_KEY=
DEEPSEEK_API_KEY=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
OWNER_WHATSAPP=
BACKEND_WEBHOOK_SECRET=
N8N_INBOUND_SECRET=
