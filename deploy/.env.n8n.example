# ============================================================
# FMS n8n — environment
# Copy to deploy/.env.n8n (gitignored) and fill in real values:
#   cp deploy/.env.n8n.example deploy/.env.n8n && nano deploy/.env.n8n
# Read by docker-compose.yml (n8n env_file), deploy/setup.sh and
# deploy/provision-n8n.js — every key below is required except
# WHATSAPP_TEMPLATE_NAME.
# ============================================================

# Meta (Facebook) WhatsApp Business Cloud API app used by the n8n workflow to
# send WhatsApp messages. Must match backend/.env's META_* values. Get both
# from developers.facebook.com -> your app -> WhatsApp -> API Setup.
META_WHATSAPP_TOKEN=change-me
META_PHONE_NUMBER_ID=change-me

# Destination (owner) number that receives alerts/reports. Digits only, E.164
# country code, NO leading "+" — that's the format Meta's API expects in the
# "to" field, e.g. 923001234567.
WHATSAPP_TO_NUMBER=change-me

# Optional (but needed for reliable alerts): the Meta-approved message template
# every alert/report is sent as — see docs/whatsapp-templates.md. Leave the
# name empty to send free-form text instead, which Meta only delivers if the
# owner messaged the business number in the last 24 hours (otherwise it is
# silently dropped). Set it only once WhatsApp Manager shows the template as
# Approved, then re-run deploy/provision-n8n.sh. The language must be the
# exact code the template was created in ("English" = en, "English (US)" = en_US).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# The n8n Webhook node rejects requests without this X-FMS-Secret header.
# Must equal N8N_WEBHOOK_SECRET in backend/.env. Generate with:
#   openssl rand -hex 32
N8N_WEBHOOK_SECRET=change-me

# Base URL n8n uses for webhook URLs it generates; substituted into the
# workflow at provision time.
WEBHOOK_URL=http://localhost:5678/

# Optional, not set here: N8N_ENCRYPTION_KEY. On first boot n8n generates its
# own key and stores it in the volume; if you set the variable it MUST equal
# the stored key or n8n refuses to start. Leave it out on first boot, then pin
# the stored key here so container recreates keep working:
#   docker compose exec n8n cat /home/node/.n8n/config   # -> "encryptionKey"
