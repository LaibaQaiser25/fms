# ============================================================
# FMS n8n — environment
# Copy to deploy/.env.n8n (gitignored) and fill in real values:
#   cp deploy/.env.n8n.example deploy/.env.n8n && nano deploy/.env.n8n
# ============================================================

# Twilio account used by the n8n workflows to send/reply on WhatsApp.
# Must match backend/.env's TWILIO_* values.
TWILIO_ACCOUNT_SID=change-me
TWILIO_AUTH_TOKEN=change-me

# The Twilio WhatsApp-enabled number (E.164, no "whatsapp:" prefix) and the
# destination (owner) number. The workflow prepends "whatsapp:" itself.
TWILIO_WHATSAPP_FROM=+14155238886
WHATSAPP_TO_NUMBER=+923007140671

# Backend as seen from inside the Docker network, and the shared secret that
# the inbound workflow sends as X-Webhook-Secret (must match backend/.env's
# BACKEND_WEBHOOK_SECRET).
BACKEND_URL=http://backend:5000
BACKEND_WEBHOOK_SECRET=change-me

# Used by older workflow exports; kept for compatibility. The setup script
# substitutes these into the workflows at provision time.
WEBHOOK_URL=http://localhost:5678/

# n8n credential encryption key. IMPORTANT: on FIRST boot n8n generates its
# own key and stores it in the volume; if you set this env var it MUST equal
# the stored key or n8n refuses to start. Safest: leave unset on first boot,
# then read the stored key from the volume and pin it here so recreates work:
#   docker compose exec n8n cat /home/node/.n8n/config   # -> "encryptionKey"
N8N_ENCRYPTION_KEY=
